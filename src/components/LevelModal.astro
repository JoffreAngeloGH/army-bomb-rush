---
import Icon from './Icon.astro';
---
<div id="level-up-screen" class="screen hide dark">
	<div id="level-up-panel" class="glass-panel">
		<h2 id="modal-title">¡Nivel 2!</h2>
		<blockquote id="modal-msg">
			<p id="modal-quote">“…”</p>
			<footer id="modal-who">Jin</footer>
		</blockquote>
		<div class="polaroid" id="modal-polaroid">
			<img id="modal-img" src="/img/jin-2.jpg" alt="Polaroid" />
			<div id="modal-polaroid-text" class="polaroid-text">¡Sigue así, Nixie!</div>
			<span class="spark">✨</span>
		</div>
		<p id="modal-message"></p>
		<p id="modal-credit" class="credit hide"></p>
		<button id="continue-btn" class="btn light" type="button">
			<span>Siguiente nivel</span>
			<Icon name="arrow-right" />
		</button>
	</div>
</div>
<style>
	h2 { margin: 0 0 4px; font-size: clamp(26px, 8vw, 32px); font-weight: 900; color: #d8b4fe; }
	#modal-msg { margin: 0 0 22px; padding: 0 4px; }
	#modal-quote { white-space: pre-line; margin: 0 0 6px; font-size: clamp(15px, 4.4vw, 18px); font-weight: 800; line-height: 1.3; font-style: italic; }
	#modal-who { font-size: 13px; font-weight: 800; color: #c4b5fd; letter-spacing: .06em; text-transform: uppercase; }
	#modal-who::before { content: '— '; }
	@media (max-height: 640px) { #modal-msg { margin-bottom: 12px; } .polaroid { width: 170px !important; margin-bottom: 20px !important; } }
	.polaroid { position: relative; width: clamp(170px, 58vw, 224px); margin: 0 auto 28px; background: #fff; padding: 10px 10px 54px; border-radius: 2px; transform: rotate(-3deg); box-shadow: 0 15px 35px rgba(0,0,0,.6); transition: transform .3s; }
	.polaroid:hover { transform: rotate(0) scale(1.05); }
	.polaroid img { display: block; width: 100%; aspect-ratio: 1; object-fit: cover; object-position: top; }
	.polaroid-text { position: absolute; bottom: 14px; left: 0; width: 100%; text-align: center; font-family: 'Kalam', cursive; font-size: clamp(17px, 5vw, 21px); color: #111; line-height: 1.1; padding: 0 8px; box-sizing: border-box; }
	.polaroid.wide { width: min(100%, 340px); }
	.polaroid.wide img { aspect-ratio: 16 / 10; object-position: center; }
	#modal-message { margin: -8px 0 18px; font-size: clamp(13px, 3.8vw, 15px); font-weight: 700; line-height: 1.4; color: #ede9fe; }
	.credit { margin: -8px 0 16px; font-size: 11px; color: #a78bfa; }
	:global(#level-up-screen.win) { background: rgba(10, 0, 30, .3); backdrop-filter: none; }
	.spark { position: absolute; top: -16px; right: -16px; font-size: 36px; animation: sparkle 1.4s ease-in-out infinite; }
	@keyframes sparkle { 50% { transform: scale(1.3); } }
</style>
