---
import Icon from './Icon.astro';
---
<div id="intro-screen" class="screen intro">
	<div class="intro-glow"></div>
	<div id="intro-panel" class="glass-panel intro-panel">
		<p class="kicker">Antes de empezar…</p>
		<p id="intro-text" class="intro-text" data-text="Yo sé que eres una erudita con la teoría, pero veamos qué tan buena eres con los reflejos."></p>
		<button id="intro-btn" class="btn primary intro-btn" type="button">
			<Icon name="zap" />
			<span>¡Vamos!</span>
		</button>
	</div>
	<div id="intro-burst" aria-hidden="true"></div>
</div>
<style>
	.intro { background: radial-gradient(circle at 50% 40%, rgba(91, 33, 182, .75), rgba(14, 4, 30, .96)); z-index: 50; }
	.intro-glow { position: absolute; width: 70vmax; height: 70vmax; border-radius: 50%; background: radial-gradient(circle, rgba(192, 132, 252, .22), transparent 60%); animation: breathe 4s ease-in-out infinite; pointer-events: none; }
	@keyframes breathe { 50% { transform: scale(1.15); opacity: .7; } }
	.intro-panel { position: relative; max-width: 400px; transition: transform .6s cubic-bezier(.5, 0, .75, 0), opacity .6s, filter .6s; }
	:global(#intro-screen.leaving) .intro-panel { transform: scale(1.6); opacity: 0; filter: blur(8px); }
	:global(#intro-screen.leaving) { animation: introFade .7s ease-in forwards; }
	@keyframes introFade { 0% { background-color: transparent; } 40% { filter: brightness(2.2); } 100% { opacity: 0; } }
	.kicker { margin: 0 0 14px; font-size: 12px; font-weight: 800; letter-spacing: .3em; text-transform: uppercase; color: #c4b5fd; }
	.intro-text { margin: 0 0 26px; min-height: 7.2em; font-size: clamp(20px, 5.6vw, 26px); font-weight: 900; line-height: 1.3; color: #fff; text-shadow: 0 0 22px rgba(192, 132, 252, .55); }
	.intro-text :global(.w) { display: inline-block; opacity: 0; transform: translateY(14px) scale(.9); filter: blur(6px); animation: wordIn .5s cubic-bezier(.34, 1.56, .64, 1) forwards; margin-right: .28em; }
	.intro-text :global(.w.hot) { color: #f0abfc; }
	@keyframes wordIn { to { opacity: 1; transform: none; filter: none; } }
	.intro-btn { opacity: 0; transform: translateY(12px); pointer-events: none; }
	:global(#intro-screen.ready) .intro-btn { animation: btnIn .5s .1s forwards, btnPulse 1.6s 1s ease-in-out infinite; pointer-events: auto; }
	@keyframes btnIn { to { opacity: 1; transform: none; } }
	@keyframes btnPulse { 50% { box-shadow: 0 0 36px rgba(167, 139, 250, .95); } }
	#intro-burst { position: absolute; left: 50%; top: 50%; width: 0; height: 0; pointer-events: none; }
	#intro-burst :global(i) { position: absolute; left: 0; top: 0; width: var(--s); height: var(--s); margin: calc(var(--s) / -2); border-radius: 50%; background: var(--c); box-shadow: 0 0 12px var(--c); opacity: 0; animation: fly .9s cubic-bezier(.15, .7, .3, 1) forwards; }
	@keyframes fly { 0% { opacity: 1; transform: translate(0, 0) scale(1); } 100% { opacity: 0; transform: translate(var(--x), var(--y)) scale(.2); } }
	@media (prefers-reduced-motion: reduce) {
		.intro-text :global(.w) { animation-duration: .01s; }
	}
</style>
